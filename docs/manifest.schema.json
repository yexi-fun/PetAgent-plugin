{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yexi-fun/PetAgent-plugin/market/manifest.schema.json",
  "title": "PetAgent Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "apiVersion", "petAgent", "type", "description", "entry", "targets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "apiVersion": { "const": 1 },
    "petAgent": { "type": "string", "minLength": 1 },
    "type": { "enum": ["mcp", "sidecar", "provider", "native-dll", "frontend", "app"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["mcp", "sidecar", "provider", "native-dll", "frontend", "app"] },
        "config": { "$ref": "#/$defs/relativePath" },
        "executable": { "$ref": "#/$defs/relativePath" },
        "library": { "$ref": "#/$defs/relativePath" },
        "abiVersion": { "type": "integer", "minimum": 1 },
        "serviceName": { "type": "string" },
        "serviceApiVersion": { "type": "integer", "minimum": 1 },
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "index"],
            "properties": {
              "root": { "$ref": "#/$defs/relativePath" },
            "index": { "$ref": "#/$defs/relativePath" },
            "protocolVersion": { "const": 1 },
            "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "window": { "$ref": "#/$defs/window" }
            }
        },
        "service": { "$ref": "#/$defs/appService" }
      }
    },
    "agent": { "type": "object", "additionalProperties": false, "properties": { "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+[a-z0-9._-]*\\.[a-z0-9._-]+$" } } } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "string" } } } },
    "conflicts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "enum": ["network", "filesystem-read", "filesystem-write", "shell", "model", "window", "microphone"] } },
    "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows-x64", "windows-arm64"] } },
    "configSchema": { "$ref": "#/$defs/relativePath" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$", "description": "Optional integrity metadata; not used for trust decisions" },
    "signature": { "type": "string", "description": "Legacy metadata; trusted-code plugins do not verify signatures" },
    "signingKeyId": { "type": "string", "description": "Legacy metadata; trusted-code plugins do not verify signatures" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "native-dll" } } },
      "then": {
        "properties": {
          "entry": {
            "required": ["library", "abiVersion", "serviceName", "serviceApiVersion"],
            "properties": {
              "abiVersion": { "const": 1 },
              "serviceName": { "const": "tools" },
              "serviceApiVersion": { "const": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "frontend" } } },
      "then": { "properties": { "entry": { "required": ["frontend"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "app" } } },
      "then": {
        "required": ["agent"],
        "properties": {
          "entry": { "required": ["service", "frontend"] }
        }
      }
    }
  ],
  "$defs": {
    "relativePath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
    "appService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "protocolVersion"],
      "properties": {
        "executable": { "$ref": "#/$defs/relativePath" },
        "protocolVersion": { "const": 1 },
        "startup": { "enum": ["on-demand", "enabled"] }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "width": { "type": "integer", "minimum": 96, "maximum": 1920 },
        "height": { "type": "integer", "minimum": 48, "maximum": 1080 },
        "resizable": { "type": "boolean" },
        "placement": { "enum": ["pet-relative", "pet-top-center"] },
        "offsetX": { "type": "integer", "minimum": -1000, "maximum": 1000 },
        "offsetY": { "type": "integer", "minimum": -1000, "maximum": 1000 }
      }
    }
  }
}
